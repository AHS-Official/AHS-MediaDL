# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Operating system files
Thumbs.db
db.properties
Desktop.ini
.DS_Store

# Local application data and settings (contains private user history & settings)
data/settings.json
data/history.json
data/collected_links
data/
config.json
history.json
ahs_settings.json
batch_links.txt
formats_summary.json
cache/

# Log files and crash dumps
*.log
crash.log

# Temporary scratch and test files
scratch/
test_*.py

# Virtual environment directories (in case you create a virtualenv)
venv/
.venv/
env/
.env
ENV/
pip-log.txt
pip-delete-this-directory.txt

# Installer and build artifacts (if using PyInstaller to convert to exe)
build/
dist/
*.spec

# Local FFmpeg binaries (large executable files shouldn't be on GitHub)
ffmpeg/
bin/ffmpeg.exe
bin/ffprobe.exe
ffmpeg.exe
ffprobe.exe
